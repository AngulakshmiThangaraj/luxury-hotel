{
  "entities": {
    "User": {
      "title": "User",
      "description": "Staff and user profiles with system roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "fullName": { "type": "string", "description": "Full staff display name" },
        "role": { "type": "string", "enum": ["ADMIN", "RECEPTIONIST"], "description": "Hotel access role" },
        "photoURL": { "type": "string", "description": "Profile image URL" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email", "role"]
    },
    "Room": {
      "title": "Room",
      "description": "Hotel room inventory item",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Numeric room identifier" },
        "roomNumber": { "type": "string", "description": "Room number display" },
        "roomType": { "type": "string", "enum": ["SINGLE", "DOUBLE", "DELUXE", "SUITE"] },
        "pricePerNight": { "type": "number", "description": "Room rate per night in INR" },
        "status": { "type": "string", "enum": ["AVAILABLE", "OCCUPIED", "MAINTENANCE"] },
        "maxOccupancy": { "type": "number", "description": "Max guest occupancy" },
        "description": { "type": "string", "description": "Room description and view info" },
        "imageUrl": { "type": "string", "description": "Image URL for the room" },
        "amenities": { "type": "array", "description": "Room amenity tags" }
      },
      "required": ["roomNumber", "roomType", "pricePerNight", "status", "maxOccupancy"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Hotel guest profile",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Numeric identifier" },
        "name": { "type": "string", "description": "Guest full name" },
        "email": { "type": "string", "description": "Guest email" },
        "phone": { "type": "string", "description": "Guest contact number" },
        "idProof": { "type": "string", "description": "ID proof type and number" },
        "address": { "type": "string", "description": "Home address" },
        "createdAt": { "type": "string", "description": "Profile creation timestamp" }
      },
      "required": ["name", "phone"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Room reservation and billing record",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Numeric booking ID" },
        "customerId": { "type": "number", "description": "Associated customer ID" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "roomId": { "type": "number", "description": "Associated room ID" },
        "roomNumber": { "type": "string" },
        "roomType": { "type": "string" },
        "pricePerNight": { "type": "number" },
        "checkInDate": { "type": "string" },
        "checkOutDate": { "type": "string" },
        "actualCheckoutDate": { "type": "string" },
        "totalNights": { "type": "number" },
        "roomCharge": { "type": "number" },
        "servicesTotal": { "type": "number" },
        "gstAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["CONFIRMED", "CHECKED_IN", "CHECKED_OUT", "CANCELLED"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "services": { "type": "array" }
      },
      "required": ["customerId", "roomId", "checkInDate", "checkOutDate", "status"]
    },
    "ServiceItem": {
      "title": "ServiceItem",
      "description": "Hotel add-on service catalog",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "serviceName": { "type": "string" },
        "category": { "type": "string", "enum": ["FOOD", "LAUNDRY", "SPA", "TRANSPORT"] },
        "price": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["serviceName", "category", "price"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Generated customer invoice",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "bookingId": { "type": "number" },
        "invoiceDate": { "type": "string" },
        "customerName": { "type": "string" },
        "roomNumber": { "type": "string" },
        "grandTotal": { "type": "number" },
        "paymentMode": { "type": "string" },
        "transactionRef": { "type": "string" }
      },
      "required": ["invoiceNumber", "bookingId", "customerName", "grandTotal"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Hotel staff and manager accounts"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Hotel room inventory with live status and pricing"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Registered hotel guests"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Room reservations and active stays"
    },
    "/services/{serviceId}": {
      "schema": "ServiceItem",
      "description": "Hotel services catalog"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Guest checkout invoices and billing records"
    }
  }
}
